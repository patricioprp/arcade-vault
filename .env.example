# Copy to .env.local and fill in. Used by the contact form on /about (SPEC 03).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Recipient of contact messages. Without a verified domain, Resend only
# delivers to the email of your Resend account, so use that one.
CONTACT_TO_EMAIL=

# Sender. onboarding@resend.dev works without a verified domain.
CONTACT_FROM_EMAIL="<onboarding@resend.dev>"

# Supabase (SPEC 04). Project Settings → API. The publishable key starts with sb_publishable_.
NEXT_PUBLIC_SUPABASE_URL=https://qtfrcvqggtwcjxxcrurn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for the CLI (db push). Never read by the app. The CLI does not load
# .env.local: export it in your shell before `npm run db:push`.
SUPABASE_DB_PASSWORD=
